#!/bin/bash
# netlock - block all network traffic on macOS except for chosen apps (--allow),
# or block only chosen apps (--block). Uses pf.
# An app is matched by process (any path containing /Name.app/, child
# processes included), so it may already be running. Every POLL seconds netlock
# lists the sockets of those processes (--allow) or of every other process
# (--block) with lsof and loads pass rules for their local ports into the pf
# anchor "netlock"; everything else stays blocked. A new socket of a passed
# process waits for one TCP retry (about 1 s) before it is passed.
# Needs root. Restores the default pf config on exit (Ctrl+C, SIGTERM, SIGHUP).
# After a kill -9 run: sudo netlock restore
# While running it shows live per-process traffic (nettop) since start.
# Written for the stock /bin/bash 3.2.

PFCONF=/etc/pf.conf
ANCHOR=netlock
POLL=0.5                            # TCP resends a lost SYN after 1 s, so a new socket is passed before that
CONFIG_REL=.config/netlock/allow    # per user, written by netlock-apps

MODE=allow         # allow: everything blocked except APPS; block: only APPS blocked
APPS=()
ALLOW_PORTS=(53)
APP_MATCH=()        # one per app: "/Name.app/" (substring of the process path) or an exact binary path
DRY_RUN=0
VERBOSE=0
MONITOR=1

WAS_ENABLED=0
TOKEN=""
ARMED=0
RESTORED=0
SLEEP_PID=""
MON_PID=""
PIDFILE=""
LAST_RULES=""
PIDS=""
SOCKETS=""          # --block: every process's sockets, read before the process list
RESPONSIBLE=""      # "pid responsible-pid" per XPC service seen; launchctl procinfo is slow and the answer never changes

usage() {
  cat <<USAGE
usage:
  sudo netlock [--allow <app>[,<app>...]] [--allow-port <port>[,...]] [--no-monitor] [--dry-run] [--verbose]
  sudo netlock --block <app>[,<app>...] [--no-monitor] [--dry-run] [--verbose]
  sudo netlock status    # pf state, netlock rules loaded?, ports currently passed or blocked
  sudo netlock restore   # manual restore after kill -9 / crash

<app>  name from /Applications, ~/Applications or /System/Applications (Firefox, Slack),
       a path to a binary or .app bundle, or bundle:com.example.app
Allowed apps may already be running. Their child processes count as the app.
Apps listed in ~/.config/netlock/allow (pick them with netlock-apps, no sudo) are always allowed too.
Without --allow and with an empty list everything except DNS (port 53) is blocked.
With --block only those apps are cut off and everything else keeps the network;
a new connection of another app waits about 1 s (one TCP retry) before it passes
(--allow, --allow-port and ~/.config/netlock/allow don't apply).
While running, a live table shows traffic per process since start (--no-monitor turns it off).
USAGE
}

log()  { echo "netlock: $*" >&2; }
vlog() { (( VERBOSE )) && log "$@"; return 0; }
die()  { log "$*"; exit 1; }

need_root() { [[ $EUID -eq 0 ]] || die "must run as root: sudo netlock ..."; }
user_home() { dscl . -read "/Users/${SUDO_USER:-$USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}'; }

load_config() {   # apps picked with netlock-apps, merged with --allow
  local f="$(user_home)/$CONFIG_REL" l
  [[ -r $f ]] || return 0
  while IFS= read -r l || [[ -n $l ]]; do
    [[ -n $l && $l != \#* ]] && APPS+=("$l")
  done < "$f"
  vlog "config $f read"
}

# ------------------------------------------------------- app resolution
resolve_app() {   # <spec> -> prints "/Name.app/" for an app bundle or the binary path, or fails
  local spec=$1 app="" dir
  case $spec in
    bundle:*)
      app=$(mdfind "kMDItemCFBundleIdentifier == '${spec#bundle:}'" 2>/dev/null | grep '\.app$' | head -n 1)
      [[ -n $app ]] || return 1 ;;
    /*)
      if [[ -d $spec && $spec == *.app ]]; then app=$spec
      elif [[ -f $spec && -x $spec ]]; then echo "$spec"; return 0
      else return 1; fi ;;
    *)
      for dir in /Applications "$(user_home)/Applications" /System/Applications /System/Applications/Utilities; do
        if [[ -d "$dir/$spec.app" ]]; then app="$dir/$spec.app"; break; fi
      done
      [[ -n $app ]] || return 1 ;;
  esac
  [[ -d "$app/Contents/MacOS" ]] || return 1
  # System apps run from a Cryptex path, not /Applications, so match the bundle name anywhere in the path
  echo "/$(basename "$app")/"
}

responsible_of() {   # <pid> -> "pid responsible-pid" (0 when launchd doesn't know it)
  local r
  r=$(launchctl procinfo "$1" 2>/dev/null | awk -F' = ' '$1 ~ /^[[:space:]]*responsible pid$/ { print $2; exit }')
  echo "$1 ${r:-0}"
}
export -f responsible_of

allowed_pids() {   # -> PIDS: every process of the listed apps, children and their XPC services included
  local list new
  list=$(ps -axww -o pid=,ppid=,comm=)
  # An XPC service like com.apple.WebKit.Networking (Safari's traffic) runs under launchd, not under
  # the app; launchd records the app as its responsible process. Ask once per new service, 16 at a time.
  new=$(awk 'NR == FNR { known[$1] = 1; next }
    $2 == 1 && $0 ~ /\.xpc\/Contents\/MacOS\// && !($1 in known) { print $1 }' <(echo "$RESPONSIBLE") <(echo "$list"))
  [[ -n $new ]] && RESPONSIBLE+=$(xargs -P 16 -n 1 /bin/bash -c 'responsible_of "$1"' _ <<<"$new")$'\n'
  PIDS=$(awk -v m="$(IFS="|"; echo "${APP_MATCH[*]}")" '
    BEGIN { n = split(m, M, "|") }
    NR == FNR { if (NF == 2) resp[$1] = $2; next }
    {
      pid = $1; parent[pid] = $2
      comm = $0; sub(/^ *[0-9]+ +[0-9]+ +/, "", comm)
      for (i = 1; i <= n; i++) {
        if (M[i] == "") continue
        if (M[i] ~ /\.app\/$/ ? index(comm, M[i]) > 0 : comm == M[i]) { hit[pid] = 1; break }
      }
    }
    END {
      do { more = 0; for (p in parent) if (!(p in hit) && (parent[p] in hit)) { hit[p] = 1; more = 1 } } while (more)
      for (p in resp) if ((p in parent) && (resp[p] in hit)) hit[p] = 1
      for (p in hit) print p
    }' <(echo "$RESPONSIBLE") <(echo "$list"))
  # Forget services that have exited, so the cache stays the size of the running ones.
  RESPONSIBLE=$(awk 'NR == FNR { alive[$1] = 1; next } ($1 in alive)' <(echo "$list") <(echo "$RESPONSIBLE"))$'\n'
  return 0
}

anchor_rules() {   # pids... -> pf rules passing the local ports of their sockets (--allow), or of every other process's sockets (--block)
  local list
  if [[ $MODE == block ]]; then
    list=$SOCKETS
  else
    (( $# )) || return 0
    list=$(lsof -a -n -P -i -p "$(IFS=,; echo "$*")" -F pPn 2>/dev/null)
  fi
  awk -v mode="$MODE" -v blocked=" $* " '
    /^p/ { mine = mode == "allow" || index(blocked, " " substr($0, 2) " ") == 0; next }
    /^P/ { proto = tolower(substr($0, 2)); next }
    /^n/ {
      if (proto ~ /^icmp/) { if (mine) icmp[proto] = 1; else noicmp[proto] = 1; next }   # ping: an ICMP socket has no port
      local = substr($0, 2); remote = ""
      if (local ~ /->/) { remote = local; sub(/.*->/, "", remote); sub(/->.*/, "", local) }
      port = local; sub(/.*:/, "", port)
      if (port !~ /^[0-9]+$/ || (proto != "tcp" && proto != "udp")) next
      if (!mine) { stop[proto, port] = 1; next }   # a port the blocked app shares stays blocked
      # A connected socket is passed with its far end too, so a port another app reuses before the
      # next refresh does not pass. Link-local (lsof embeds the scope) and IPv4-mapped addresses fall back to the port alone.
      raddr = remote; rport = remote; sub(/:[^:]*$/, "", raddr); sub(/.*:/, "", rport); gsub(/[][]/, "", raddr)
      if (rport ~ /^[0-9]+$/ && raddr !~ /^[fF][eE]80/ && (raddr ~ /^[0-9.]+$/ || raddr ~ /^[0-9a-fA-F:]+$/)) conn[proto, port, raddr, rport] = 1
      else pass[proto, port] = 1
    }
    END {
      for (k in pass) if (!(k in stop)) { split(k, f, SUBSEP); ports[f[1]] = ports[f[1]] " " f[2] }
      for (k in conn) {
        split(k, f, SUBSEP)
        if (((f[1], f[2]) in stop) || ((f[1], f[2]) in pass)) continue
        flags = f[1] == "tcp" ? " flags any" : ""
        printf "pass out quick proto %s from any port %s to %s port %s%s\n", f[1], f[2], f[3], f[4], flags
        printf "pass in quick proto %s from %s port %s to any port %s%s\n", f[1], f[3], f[4], f[2], flags
      }
      # shortcut: pf cannot tell whose ICMP echo it is, so ping passes for every process while a passed
      # process has an ICMP socket and the blocked app has none; upgrade with a Network Extension filter.
      if (("icmp" in icmp) && !("icmp" in noicmp)) print "pass out quick inet proto icmp icmp-type echoreq"
      if (("icmpv6" in icmp) && !("icmpv6" in noicmp)) print "pass out quick inet6 proto icmp6 icmp6-type echoreq"
      # flags any: a connection that exists before its rule (app already running) is picked up mid-stream
      if ("tcp" in ports) {
        printf "pass out quick proto tcp from any port {%s } flags any\n", ports["tcp"]
        printf "pass in quick proto tcp to any port {%s } flags any\n", ports["tcp"]
      }
      if ("udp" in ports) {
        printf "pass out quick proto udp from any port {%s }\n", ports["udp"]
        printf "pass in quick proto udp to any port {%s }\n", ports["udp"]
      }
    }' <<<"$list"
}

refresh() {   # scan the allowed apps and reload the anchor when their port set changes
  local pids rules
  # --block: sockets first, then processes, so a socket's owner is always in the process list.
  # The other way round, an app process started in between would count as another app for one round.
  [[ $MODE == block ]] && SOCKETS=$(lsof -n -P -i -F pPn 2>/dev/null)
  allowed_pids
  pids=$PIDS
  printf '%s\n' $pids > "$PIDFILE"      # the monitor reads it for the * marker
  rules=$(anchor_rules $pids | sort)
  [[ $rules == "$LAST_RULES" ]] && return 0
  if [[ -z $rules ]]; then
    pfctl -q -a "$ANCHOR" -F rules 2>/dev/null
  else
    printf '%s\n' "$rules" | pfctl -q -a "$ANCHOR" -f - 2>/dev/null || log "warning: anchor reload failed"
  fi
  LAST_RULES=$rules
  vlog "anchor reloaded: $(wc -w <<<"$pids" | tr -d ' ') processes"
}

# -------------------------------------------------------------- ruleset
ruleset() {   # both modes: everything blocked except DNS and the ports the anchor passes
  cat <<RULES
# netlock
set skip on lo0
pass out quick proto { tcp udp } to any port { ${ALLOW_PORTS[*]} }
anchor "$ANCHOR"
block drop out all
block drop in all
RULES
}

# -------------------------------------------------------------- restore
restore() {
  (( RESTORED )) && return 0
  RESTORED=1
  (( ARMED )) || return 0
  pfctl -q -f "$PFCONF" 2>/dev/null || log "warning: could not reload $PFCONF"
  pfctl -q -a "$ANCHOR" -F rules 2>/dev/null
  if (( ! WAS_ENABLED )); then
    # -X releases our reference; pf stays up only if something else (VPN) holds one
    if [[ -n $TOKEN ]]; then pfctl -q -X "$TOKEN" 2>/dev/null; else pfctl -q -d 2>/dev/null; fi
  fi
  log "network restored"
}

cleanup() {
  restore
  [[ -n $SLEEP_PID ]] && kill "$SLEEP_PID" 2>/dev/null
  if [[ -n $MON_PID ]]; then pkill -P "$MON_PID" 2>/dev/null; kill "$MON_PID" 2>/dev/null; fi
  [[ -n $PIDFILE ]] && rm -f "$PIDFILE"
  return 0
}

cmd_restore() {
  need_root
  pfctl -q -f "$PFCONF" 2>/dev/null || log "warning: could not reload $PFCONF"
  pfctl -q -a "$ANCHOR" -F rules 2>/dev/null
  pfctl -q -d 2>/dev/null
  log "network restored (default ruleset loaded, pf disabled)"
}

# --------------------------------------------------------------- status
cmd_status() {
  need_root
  if pfctl -s info 2>/dev/null | grep -q 'Status: Enabled'; then echo "pf: enabled"; else echo "pf: disabled"; fi
  if pfctl -s rules 2>/dev/null | grep -q "^anchor \"$ANCHOR\""; then echo "netlock rules: loaded"; else echo "netlock rules: not loaded"; fi
  echo "ports passed (anchor $ANCHOR):"
  pfctl -a "$ANCHOR" -s rules 2>/dev/null | sed 's/^/  /' | grep . || echo "  (none)"
}

# -------------------------------------------------------------- monitor
# Live per-process traffic since start, redrawn every second. nettop block-buffers
# when writing to a pipe, so it runs under a pty (script). Its first sample is
# cumulative since process start and is skipped; later samples are 1 s deltas.
# -t external leaves out loopback, which pf never blocks. Every line is cut to
# the terminal width: a wrapped line would scroll the screen on each redraw.
monitor() {
  local rows cols size
  size=$(stty size </dev/tty 2>/dev/null) || size="24 80"   # not tput: inside $( ) it sees no tty
  rows=$(( ${size% *} - 7 ))
  (( rows < 5 )) && rows=5
  cols=${size#* }
  printf '\033[H\033[2J'
  script -q /dev/null nettop -P -d -L 0 -s 1 -x -J bytes_in,bytes_out -t external </dev/null 2>/dev/null |
  awk -v start="$(date +%s)" -v rows="$rows" -v cols="$cols" -v pidfile="$PIDFILE" \
      -v mode="$MODE" -v apps="${APPS[*]:-none}" -v ports="${ALLOW_PORTS[*]}" '
    function human(b) {
      if (b < 1024) return b " B"
      if (b < 1048576) return sprintf("%.0f KB", b / 1024)
      if (b < 1073741824) return sprintf("%.1f MB", b / 1048576)
      return sprintf("%.2f GB", b / 1073741824)
    }
    function line(s) { printf "%s\033[K\n", substr(s, 1, cols) }
    function draw(   cmd, l, k, t, max, w, bar, j, n, p, now, el, mark, row) {
      delete okpid
      while ((getline l < pidfile) > 0) okpid[l] = 1
      close(pidfile)
      "date +%s" | getline now; close("date +%s")
      el = now - start
      printf "\033[H"
      line(sprintf("netlock  %s  (in %s, out %s)  up %02d:%02d:%02d   Ctrl+C restores network", human(tin + tout), human(tin), human(tout), el / 3600, (el % 3600) / 60, el % 60))
      if (mode == "block") {
        line("blocked: " apps)
        line("* = blocked app (no network)")
      } else {
        line("allowed: " apps "   ports: " ports)
        line("* = allowed app (has network)   no *: out = blocked retries, tiny in = DNS")
      }
      line("")
      line(sprintf("%-17s %10s %10s %10s", "PROCESS", "IN", "OUT", "TOTAL"))
      max = 0
      for (k in tot) if (tot[k] > max) max = tot[k]
      fflush()
      cmd = "sort -t\"\t\" -k1,1nr | cut -f2- | head -n " rows
      for (k in tot) {
        t = tot[k]
        if (t == 0) continue
        mark = " "
        n = split(pids[k], p, " ")
        for (j = 1; j <= n; j++) if (p[j] in okpid) mark = "*"
        bar = ""
        w = int(20 * t / max)
        for (j = 0; j < w; j++) bar = bar "="
        row = sprintf("%s%-16s %10s %10s %10s  %s", mark, k, human(inb[k]), human(outb[k]), human(t), bar)
        printf "%d\t%s\033[K\n", t, substr(row, 1, cols) | cmd
      }
      close(cmd)
      printf "\033[J"
      fflush()
    }
    { sub(/\r$/, "") }
    /,bytes_in,bytes_out/ { sample++; if (sample >= 2) draw(); next }
    sample == 1 { next }
    {
      split($0, f, ",")
      k = f[1]; pid = k
      sub(/\.[0-9]+$/, "", k); sub(/^.*\./, "", pid)
      inb[k] += f[2]; outb[k] += f[3]; tot[k] = inb[k] + outb[k]
      tin += f[2]; tout += f[3]
      if (index(" " pids[k] " ", " " pid " ") == 0) pids[k] = pids[k] " " pid
    }'
}

# ------------------------------------------------------------ main mode
cmd_run() {
  local spec m
  [[ $MODE == allow ]] && load_config
  if (( ${#APPS[@]} )); then
    local -a uniq=()
    while IFS= read -r spec; do uniq+=("$spec"); done < <(printf '%s\n' "${APPS[@]}" | awk '!seen[$0]++')
    APPS=("${uniq[@]}")
  fi
  for spec in "${APPS[@]}"; do
    m=$(resolve_app "$spec") || die "cannot find app: $spec"
    vlog "$spec -> $m"
    APP_MATCH+=("$m")
  done

  if (( DRY_RUN )); then
    ruleset
    echo
    echo "# anchor \"$ANCHOR\" is rebuilt every ${POLL}s from the sockets of the listed apps, e.g.:"
    [[ $MODE == block ]] && echo "# (with --block: the sockets of every other process)"
    echo "# pass out quick proto tcp from any port { 51597 51612 } flags any"
    echo "# pass in quick proto tcp to any port { 51597 51612 } flags any"
    exit 0
  fi

  need_root
  command -v lsof >/dev/null || die "lsof not found"
  [[ -t 1 ]] || MONITOR=0
  if (( MONITOR )) && ! command -v nettop >/dev/null; then MONITOR=0; log "nettop not found, monitor off"; fi

  pfctl -s info 2>/dev/null | grep -q 'Status: Enabled' && WAS_ENABLED=1
  vlog "pf was $( (( WAS_ENABLED )) && echo enabled || echo disabled ) before start"

  trap 'cleanup; exit 130' INT
  trap 'cleanup; exit 143' TERM HUP
  trap cleanup EXIT

  ARMED=1
  local out
  out=$(pfctl -E 2>&1) || die "pfctl -E failed: $out"
  TOKEN=$(awk '/^Token/ {print $3}' <<<"$out")
  vlog "pf enabled, token ${TOKEN:-none}"
  out=$(ruleset | pfctl -q -f - 2>&1) || die "pf rejected the ruleset: $out"
  pfctl -q -F states 2>/dev/null   # connections opened before netlock started must not survive
  (( VERBOSE )) && ruleset >&2

  PIDFILE=$(mktemp /tmp/netlock.XXXXXX) || die "cannot create temp file"
  refresh

  if (( MONITOR )); then
    monitor &
    MON_PID=$!
  else
    echo
    echo "netlock ACTIVE  (Ctrl+C restores the network)"
    if [[ $MODE == block ]]; then
      echo "  blocked : apps ${APPS[*]} (running or started later, children included)"
      echo "  allowed : everything else (a new connection waits about 1 s)"
    else
      echo "  blocked : all traffic in + out, every process"
      echo "  allowed : ports ${ALLOW_PORTS[*]} (tcp/udp, all processes)"
      echo "  allowed : apps ${APPS[*]:-none} (running or started later, children included)"
    fi
    echo "  after a crash: sudo netlock restore"
    echo
  fi
  while :; do
    refresh
    if [[ -n $MON_PID ]] && ! kill -0 "$MON_PID" 2>/dev/null; then MON_PID=""; log "monitor stopped, network still blocked"; fi
    sleep "$POLL" &
    SLEEP_PID=$!
    wait "$SLEEP_PID"
  done
}

# ----------------------------------------------------------------- args
case ${1:-} in
  status)         cmd_status ;;
  restore)        cmd_restore ;;
  setup)          log "setup is no longer needed: this version matches apps by process, not by group"; exit 0 ;;
  -h|--help|help) usage ;;
  *)
    while (( $# )); do
      case $1 in
        --allow)
          [[ -n ${2:-} ]] || die "--allow needs a value"
          IFS=, read -ra parts <<<"$2"
          APPS+=("${parts[@]}")
          ALLOW_GIVEN=1
          shift 2 ;;
        --block)
          [[ -n ${2:-} ]] || die "--block needs a value"
          IFS=, read -ra parts <<<"$2"
          APPS+=("${parts[@]}")
          MODE=block
          shift 2 ;;
        --allow-port)
          [[ -n ${2:-} ]] || die "--allow-port needs a value"
          IFS=, read -ra parts <<<"$2"
          for p in "${parts[@]}"; do
            [[ $p =~ ^[0-9]+$ && $p -ge 1 && $p -le 65535 ]] || die "bad port: $p"
            ALLOW_PORTS+=("$p")
          done
          shift 2 ;;
        --no-monitor) MONITOR=0; shift ;;
        --dry-run)    DRY_RUN=1; shift ;;
        -v|--verbose) VERBOSE=1; shift ;;
        *)            usage >&2; die "unknown argument: $1" ;;
      esac
    done
    [[ $MODE == block && -n ${ALLOW_GIVEN:-} ]] && die "use --allow or --block, not both"
    cmd_run ;;
esac
